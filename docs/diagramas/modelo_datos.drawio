"edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="ocupantes (documentos)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;exitX=1;exitY=0.5;entryX=0;entryY=0.85;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="1 — *" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="miembros  0..1 — *" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c15" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1560" y="488"/><mxPoint x="1560" y="142"/></Array></mxGeometry></mxCell><mxCell id="c33" value="destino" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;exitX=1;exitY=0.3;entryX=1;entryY=0.8;" edge="1" parent="1" source="c16" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1560" y="629"/><mxPoint x="1560" y="518"/></Array></mxGeometry></mxCell><mxCell id="c34" value="pareja" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;exitX=0;exitY=0.3;entryX=0;entryY=0.7;" edge="1" parent="1" source="c17" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="615"/><mxPoint x="920" y="687"/></Array></mxGeometry></mxCell><mxCell id="c35" value="&lt;b&gt;Estructuras de datos usadas&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Mapas&lt;/b&gt;: el estado de cada GenServer es %{id =&amp;gt; struct}; el inventario es %{centro =&amp;gt; cantidad}.&lt;br&gt;• &lt;b&gt;Listas anidadas&lt;/b&gt;: zona → sectores → puntos, recorridas con funciones recursivas ([head | tail]).&lt;br&gt;• &lt;b&gt;MapSet&lt;/b&gt;: ocupantes de un albergue, miembros de una familia y palabras de las características en Similitud.&lt;br&gt;• &lt;b&gt;Tuplas&lt;/b&gt;: resultados {:ok, valor} y {:error, razon}; destino {tipo, codigo}; partes de una reserva {codigo, centro, cantidad}.&lt;br&gt;• &lt;b&gt;Structs&lt;/b&gt;: una por entidad, con valores por defecto.&lt;br&gt;• &lt;b&gt;Átomos&lt;/b&gt; para estados, prioridades, niveles y tipos, con tablas de transición válidas.&lt;br&gt;&lt;br&gt;&lt;i&gt;Todas las entidades con campo zona guardan el código de una Zona y lo verifican con Zonas.existe?/1.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;rounded=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="540" width="560" height="250" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Persistencia&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cada struct tiene su archivo en datos/ (texto plano, una línea por registro, campos separados por ;).&lt;br&gt;&lt;br&gt;movimientos, historial_personas y actividad solo agregan líneas." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontFamily=Helvetica;rounded=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometr